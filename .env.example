# 复制本文件为 .env.local 后填写；.env.local 已被 .gitignore 忽略，不会进仓库。
# 这些值由云服务（WorkBuddy Cloud Service / 兼容 PostgREST 的托管后端）开通后下发。

# 应用发布域名，承载 /.cloud/** 接口
VITE_CLOUD_ENDPOINT=https://your-app.example.com

# OAuth 中继地址（由控制台下发，不同环境不同，不要自行拼接）
VITE_CLOUD_OAUTH_RELAY=https://your-oauth-relay.example.com/oauth

# 客户端 publishable key，可公开但绑定域名与额度，请勿提交真实值
VITE_CLOUD_PUBLISHABLE_KEY=wbpk_your_project_id_your_publishable_key

# 收款页展示的管理员微信号（示例占位，部署时替换为自己的）
VITE_ADMIN_WECHAT=your-wechat-id
