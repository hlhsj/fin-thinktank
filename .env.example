# 复制本文件为 .env 或 .env.local 后填写；这两个文件均已被 .gitignore 忽略，不会进仓库。
# v2.0.0 起前端不再持有任何云数据库凭据——所有读写都经 Python 后端（app/）转发。

# ─────────────────────────────────────────────
# 后端必填（缺失时 app 启动即报错，避免「起来了但读不到数据」）
# ─────────────────────────────────────────────

# 云数据库 PostgREST 网关地址：你的应用域名 + /.cloud/database/rest
FT_DB_URL=https://your-app.example.com/.cloud/database/rest

# 服务端凭据（控制台下发，绑定域名与额度）。
# 注意：这是「服务端 key」，权限高于前端 publishable key，切勿下发到浏览器或提交到仓库。
FT_DB_KEY=wbpk_your_project_id_your_server_key

# 请求来源头，需与 FT_DB_URL 的域名一致（PostgREST 网关会校验）
FT_DB_ORIGIN=https://your-app.example.com

# ─────────────────────────────────────────────
# 后端可选（均有合理默认值，见 app/settings.py）
# ─────────────────────────────────────────────

# 服务端口（默认 4173）
# PORT=4173

# 前端构建产物目录（默认 ./dist）
# FT_DIST=./dist

# 估值引擎目录（默认 ./stock_value_estimator-main）
# FT_ENGINE_DIR=./stock_value_estimator-main

# HTTP 超时 / 连接池
# FT_HTTP_TIMEOUT=30
# FT_HTTP_MAX_CONN=24
# FT_HTTP_MAX_KEEPALIVE=12

# 公共数据与会话缓存（秒）
# FT_CACHE_TTL_PUBLIC=180
# FT_CACHE_TTL_SESSION=300

# ─────────────────────────────────────────────
# 数据维护任务（jobs/，仅在你自行跑定时任务时需要）
# ─────────────────────────────────────────────

# 管理员账号（仅 --apply 写库时需要；也可用 --phone/--password 命令行传入）
# FT_ADMIN_PHONE=13800000000
# FT_ADMIN_PASSWORD=000000

# 数据新鲜度告警阈值（天）
# FT_FRESHNESS_MAX_LAG=3

# ─────────────────────────────────────────────
# 其他
# ─────────────────────────────────────────────

# 收款页展示的管理员微信号：当前是源码常量（src/pages/PayPage.tsx 的 ADMIN_WECHAT），
# 部署前改成自己的；收款码图片替换 public/wechat-pay-qr.jpg。
